  "typography": {
    "ui-font-size": "14px",
    "ui-xl": "18px",
    "ui-lg": "16px",
    "ui-base": "14px",
    "ui-caption": "13px",
    "ui-sm": "12px",
    "ui-xs": "10px",
    "mobile-input-safe": "16px",
    "line-heading": "1.3",
    "line-body": "1.55",
    "line-compact": "1.4"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px"
  },
  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "12px",
    "2xl": "16px",
    "full": "999px"
  },
  "control": {
    "xs": "20px",
    "sm": "24px",
    "md": "28px",
    "lg": "32px",
    "input": "36px"
  },
  "motion": {
    "press-duration": "120ms",
    "state-duration": "150ms",
    "overlay-duration": "180ms",
    "sidebar-duration": "220ms",
    "spinner-duration": "900ms",
    "ease-out": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "elevation": {
    "overlay": "0 12px 32px rgba(0, 0, 0, 0.14)",
    "attention": "0 16px 42px rgba(0, 0, 0, 0.18)"
  },
  "layout": {
    "rail-width": "48px",
    "sidebar-width": "240px",
    "titlebar-height": "44px",
    "reading-column": "760px",
    "fixture-column": "920px",
    "settings-column": "800px",
    "assistant-skill-list-height": "320px",
    "assistant-dialog-width": "640px",
    "assistant-dialog-height": "640px",
    "model-menu-width": "360px",
    "model-menu-height": "280px"
  },
  "font": {
    "ui": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Microsoft YaHei UI\", \"PingFang SC\", monospace"
  },
  "icon": {
    "sm": "14px",
    "md": "16px",
    "lg": "18px",
    "brand": "28px"
  },
  "border": {
    "default": "1px",
    "focus": "2px"
  },
  "layer": {
    "base": 0,
    "sticky": 10,
    "popover": 30,
    "overlay": 50,
    "toast": 70
  },
  "weight": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
